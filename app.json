{
  "expo": {
    "name": "RIMT Academic Trust",
    "slug": "rimt-academic-trust",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.alexander_x.rimtacademictrust",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "RIMT Academic Trust uses your selected photo for your scholar profile.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A365D",
          "defaultChannel": "rimt_official_alerts"
        }
      ]
    ]
  }
}
